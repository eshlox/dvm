#!/usr/bin/env bash
set -Eeuo pipefail

DVM_CONFIG_DIR="${DVM_CONFIG_DIR:-$HOME/.config/dvm}"
DVM_CACHE_DIR="${DVM_CACHE_DIR:-$HOME/.cache/dvm}"
LIMACTL="${DVM_LIMACTL:-limactl}"
DVM_VERSION="0.1.0-dev"

die() { printf 'dvm: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
lima_name() { printf 'dvm-%s\n' "$1"; }
valid_name() { case "$1" in *[!a-z0-9-]*|''|[!a-z]*) return 1 ;; esac; }

stat_uid() {
    stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1" 2>/dev/null
}

stat_mode() {
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null
}

assert_safe_path() {
    local path="$1" label="$2" uid mode
    [ -e "$path" ] || return 0
    uid="$(stat_uid "$path")" || die "cannot inspect $label ownership: $path"
    [ "$uid" = "$(id -u)" ] || die "$label must be owned by the current user: $path"
    mode="$(stat_mode "$path")" || die "cannot inspect $label permissions: $path"
    if (( (8#$mode & 0022) != 0 )); then
        die "unsafe permissions on $label: $path (repair: chmod go-w '$path')"
    fi
}

assert_setup_script() {
    local path="$1" label="$2"
    [ -n "$path" ] || return 0
    case "$path" in /*) ;; *) die "$label must be an absolute path: $path" ;; esac
    [ -f "$path" ] || die "$label not found: $path"
    [ -r "$path" ] || die "$label is not readable: $path"
    assert_safe_path "$path" "$label"
}

require_lima() {
    have "$LIMACTL" || die "limactl not found: $LIMACTL"
}

load_global() {
    [ -d "$DVM_CONFIG_DIR" ] && assert_safe_path "$DVM_CONFIG_DIR" "config directory"
    DVM_TEMPLATE="template:fedora"
    DVM_CPUS=2
    DVM_MEMORY=4
    DVM_DISK=30
    DVM_USER=developer
    DVM_PORTS=()
    DVM_GLOBAL_SETUP=
    DVM_SETUP=
    # shellcheck source=/dev/null
    if [ -f "$DVM_CONFIG_DIR/config.sh" ]; then
        assert_safe_path "$DVM_CONFIG_DIR/config.sh" "global config"
        . "$DVM_CONFIG_DIR/config.sh"
    fi
    valid_name "$DVM_USER" || die "invalid DVM_USER: $DVM_USER"
    assert_setup_script "$DVM_GLOBAL_SETUP" "global setup script"
}

load_vm() {
    valid_name "$1" || die "invalid VM name: $1"
    local f="$DVM_CONFIG_DIR/vms/$1.sh"
    [ -f "$f" ] || die "no config for VM \"$1\" at $f"
    load_global
    assert_safe_path "$DVM_CONFIG_DIR/vms" "VM config directory"
    assert_safe_path "$f" "VM config"
    DVM_NAME="$1"
    DVM_LIMA_NAME="$(lima_name "$DVM_NAME")"
    DVM_SETUP=
    # shellcheck source=/dev/null
    . "$f"
    valid_name "$DVM_USER" || die "invalid DVM_USER: $DVM_USER"
    DVM_CODE_DIR="/home/$DVM_USER/code/$DVM_NAME"
    validate_ports
    assert_setup_script "$DVM_GLOBAL_SETUP" "global setup script"
    assert_setup_script "$DVM_SETUP" "VM setup script"
}

validate_ports() {
    local p host guest extra
    for p in "${DVM_PORTS[@]:-}"; do
        [ -n "$p" ] || continue
        IFS=: read -r host guest extra <<<"$p"
        if [ -n "${extra:-}" ]; then
            die "bad port spec (extra ':'): $p"
        fi
        if [ -z "${host:-}" ] || [ -z "${guest:-}" ]; then
            die "bad port spec: $p"
        fi
        case "$host$guest" in *[!0-9]*) die "port must be numeric: $p" ;; esac
        if [ "$host" -lt 1 ] || [ "$host" -gt 65535 ]; then
            die "port out of range 1-65535: $p"
        fi
        if [ "$guest" -lt 1 ] || [ "$guest" -gt 65535 ]; then
            die "port out of range 1-65535: $p"
        fi
    done
}

lock_vm() {
    mkdir -p "$DVM_CACHE_DIR"
    local d="$DVM_CACHE_DIR/$1.lock"
    if ! mkdir "$d" 2>/dev/null; then
        die "VM \"$1\" busy: another dvm operation is in progress (rm $d if stale)"
    fi
    trap 'rmdir "'"$d"'" 2>/dev/null || true' EXIT INT TERM
}

DVM_ARGV=()

port_forward_args() {
    local p host guest
    for p in "${DVM_PORTS[@]:-}"; do
        [ -n "$p" ] || continue
        IFS=: read -r host guest <<<"$p"
        DVM_ARGV+=(--port-forward "$host:$guest")
    done
}

build_lima_start() {
    DVM_ARGV=("$LIMACTL" start --name "$DVM_LIMA_NAME"
        --cpus "$DVM_CPUS" --memory "$DVM_MEMORY" --disk "$DVM_DISK"
        --mount-none)
    port_forward_args
    DVM_ARGV+=("$DVM_TEMPLATE")
}

print_argv() {
    local x
    for x in "${DVM_ARGV[@]}"; do printf '  %q\n' "$x"; done
}

lima_has() {
    local list
    list="$("$LIMACTL" list -q)" || die "failed to list Lima instances"
    printf '%s\n' "$list" | grep -Fxq "$1"
}

vm_config_exists() {
    valid_name "$1" || return 1
    [ -f "$DVM_CONFIG_DIR/vms/$1.sh" ]
}

guest_core_exports() {
    printf 'export DVM_NAME=%q DVM_VM=%q DVM_LIMA_NAME=%q DVM_USER=%q DVM_CODE_DIR=%q DVM_PORTS=%q\n' \
        "$DVM_NAME" "$DVM_NAME" "$DVM_LIMA_NAME" "$DVM_USER" "$DVM_CODE_DIR" "$(IFS=,; printf '%s' "${DVM_PORTS[*]:-}")"
}

guest_bootstrap_script() {
    guest_core_exports
    cat <<'EOF'
set -Eeuo pipefail
if ! id "$DVM_USER" >/dev/null 2>&1; then
    if ! command -v useradd >/dev/null 2>&1; then
        printf 'dvm guest: useradd not found; create %s manually or use a template with useradd\n' "$DVM_USER" >&2
        exit 1
    fi
    if ! sudo useradd -m -s /bin/bash -K SUB_UID_COUNT=0 -K SUB_GID_COUNT=0 "$DVM_USER" 2>/tmp/dvm-useradd.err; then
        sudo useradd -m -s /bin/bash "$DVM_USER"
    fi
fi
home="$(getent passwd "$DVM_USER" | cut -d: -f6)"
[ -n "$home" ] || { printf 'dvm guest: user %s has no passwd entry\n' "$DVM_USER" >&2; exit 1; }
group="$(id -gn "$DVM_USER")" || { printf 'dvm guest: user %s has no primary group\n' "$DVM_USER" >&2; exit 1; }
sudo install -d -o "$DVM_USER" -g "$group" "$home"
sudo install -d -o "$DVM_USER" -g "$group" "$DVM_CODE_DIR"
EOF
}

run_guest_bootstrap() {
    guest_bootstrap_script | "$LIMACTL" shell --workdir / "$DVM_LIMA_NAME" bash -s
}

run_setup_script() {
    local label="$1" path="$2"
    [ -n "$path" ] || return 0
    printf 'dvm: running %s: %s\n' "$label" "$path" >&2
    {
        guest_core_exports
        printf 'set -Eeuo pipefail\n'
        cat "$path"
    } | "$LIMACTL" shell --workdir / "$DVM_LIMA_NAME" bash -s
}

print_setup_plan() {
    printf 'setup scripts:\n'
    printf '  global: %s\n' "${DVM_GLOBAL_SETUP:-<none>}"
    printf '  vm:     %s\n' "${DVM_SETUP:-<none>}"
}

cmd_sync() {
    if [ "${1:-}" = "--all" ]; then
        local rc=0 f n
        for f in "$DVM_CONFIG_DIR"/vms/*.sh; do
            [ -f "$f" ] || continue
            n="$(basename "$f" .sh)"
            printf -- '--- sync %s ---\n' "$n"
            ( cmd_sync "$n" ) || rc=1
        done
        return $rc
    fi

    [ "$#" -eq 1 ] || die "usage: dvm sync <vm> | --all"
    load_vm "$1"

    if [ "${DVM_DRY_RUN:-0}" = "1" ]; then
        printf 'VM: %s (lima: %s)\n' "$DVM_NAME" "$DVM_LIMA_NAME"
        build_lima_start
        printf 'limactl start argv:\n'
        print_argv
        print_setup_plan
        return 0
    fi

    lock_vm "$DVM_NAME"
    require_lima
    if ! lima_has "$DVM_LIMA_NAME"; then
        build_lima_start
        "${DVM_ARGV[@]}"
    fi
    "$LIMACTL" start "$DVM_LIMA_NAME" >/dev/null 2>&1 || "$LIMACTL" start "$DVM_LIMA_NAME"
    run_guest_bootstrap
    run_setup_script "global setup" "$DVM_GLOBAL_SETUP"
    run_setup_script "VM setup" "$DVM_SETUP"
}

cmd_sh() {
    [ "$#" -eq 1 ] || die "usage: dvm sh <vm>"
    load_vm "$1"
    require_lima
    lima_has "$DVM_LIMA_NAME" || die "no Lima instance: $DVM_LIMA_NAME (run: dvm sync $DVM_NAME)"
    "$LIMACTL" start "$DVM_LIMA_NAME" >/dev/null 2>&1 || "$LIMACTL" start "$DVM_LIMA_NAME"
    run_guest_bootstrap
    local sh_script
    # shellcheck disable=SC2016
    sh_script='cd "$1" 2>/dev/null || cd; exec bash -l'
    exec "$LIMACTL" shell "$DVM_LIMA_NAME" sudo -u "$DVM_USER" -H bash -lc \
        "$sh_script" bash "$DVM_CODE_DIR"
}

cmd_ssh() {
    [ "$#" -ge 1 ] || die "usage: dvm ssh <vm> -- cmd..."
    local name="$1"; shift
    load_vm "$name"
    require_lima
    [ "${1:-}" = "--" ] && shift
    [ "$#" -gt 0 ] || die "usage: dvm ssh <vm> -- cmd..."
    lima_has "$DVM_LIMA_NAME" || die "no Lima instance: $DVM_LIMA_NAME (run: dvm sync $DVM_NAME)"
    "$LIMACTL" start "$DVM_LIMA_NAME" >/dev/null 2>&1 || "$LIMACTL" start "$DVM_LIMA_NAME"
    run_guest_bootstrap
    local sh_script
    # shellcheck disable=SC2016
    sh_script='cd "$1" 2>/dev/null || cd; shift; exec "$@"'
    exec "$LIMACTL" shell "$DVM_LIMA_NAME" sudo -u "$DVM_USER" -H bash -lc \
        "$sh_script" bash "$DVM_CODE_DIR" "$@"
}

cmd_cp() {
    [ "$#" -eq 2 ] || die "usage: dvm cp <src> <dst>"
    local src_arg="$1" dst_arg="$2" src="$1" dst="$2"
    local src_is_vm=0 dst_is_vm=0 vm rest
    if [[ "$src_arg" =~ ^([a-z][a-z0-9-]*):(.*)$ ]]; then
        vm="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"
        src="$(lima_name "$vm"):$rest"; src_is_vm=1
    fi
    if [[ "$dst_arg" =~ ^([a-z][a-z0-9-]*):(.*)$ ]]; then
        vm="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"
        dst="$(lima_name "$vm"):$rest"; dst_is_vm=1
    fi
    [ $((src_is_vm + dst_is_vm)) -ge 1 ] || die "at least one path must be <vm>:<path>"
    [ $((src_is_vm + dst_is_vm)) -le 1 ] || die "cross-VM copy is not supported"
    require_lima
    exec "$LIMACTL" copy "$src" "$dst"
}

cmd_ls() {
    require_lima
    local only_config=0 filter=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --only-config) only_config=1 ;;
            *)
                [ -z "$filter" ] || die "usage: dvm ls [--only-config] [<vm>]"
                filter="$1"
                ;;
        esac
        shift
    done
    local fmt='{{.Name}}	{{.Status}}	{{.CPUs}}	{{.Memory}}'
    local name status cpus mem short rows
    rows="$("$LIMACTL" list --format "$fmt")" || die "failed to list Lima instances"
    printf '%-20s %-10s %-5s %-10s\n' VM STATE CPU MEMORY
    while IFS=$'\t' read -r name status cpus mem; do
        [ -n "$name" ] || continue
        case "$name" in dvm-*) short="${name#dvm-}" ;; *) continue ;; esac
        if [ -n "$filter" ] && [ "$short" != "$filter" ]; then continue; fi
        if [ "$only_config" = "1" ] && ! vm_config_exists "$short"; then continue; fi
        printf '%-20s %-10s %-5s %-10s\n' "$short" "$status" "$cpus" "$mem"
    done <<<"$rows"
}

cmd_stop() {
    if [ "${1:-}" = "--all" ]; then
        shift
        local only_config=0
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --only-config) only_config=1 ;;
                *) die "usage: dvm stop <vm> | --all [--only-config]" ;;
            esac
            shift
        done
        require_lima
        local rc=0 n rows
        rows="$("$LIMACTL" list -q)" || die "failed to list Lima instances"
        while IFS= read -r n; do
            case "$n" in
                dvm-*)
                    if [ "$only_config" = "1" ] && ! vm_config_exists "${n#dvm-}"; then
                        continue
                    fi
                    "$LIMACTL" stop "$n" || { rc=1; printf 'dvm: stop %s failed\n' "$n" >&2; }
                    ;;
            esac
        done <<<"$rows"
        return $rc
    fi
    [ "$#" -eq 1 ] || die "usage: dvm stop <vm> | --all"
    require_lima
    local name; name="$(lima_name "$1")"
    lima_has "$name" || return 0
    "$LIMACTL" stop "$name"
}

cmd_rm() {
    [ "$#" -ge 1 ] || die "usage: dvm rm <vm> --yes"
    local name="$1"; shift
    local yes=0 remove_config=0 config_file
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yes) yes=1 ;;
            --config) remove_config=1 ;;
            *) die "unknown flag: $1" ;;
        esac
        shift
    done
    [ "$yes" = "1" ] || die "dvm rm requires --yes"
    valid_name "$name" || die "invalid VM name: $name"
    DVM_NAME="$name"
    DVM_LIMA_NAME="$(lima_name "$DVM_NAME")"
    config_file="$DVM_CONFIG_DIR/vms/$DVM_NAME.sh"
    require_lima
    lock_vm "$DVM_NAME"
    if lima_has "$DVM_LIMA_NAME"; then
        "$LIMACTL" stop --force "$DVM_LIMA_NAME" >/dev/null 2>&1 || true
        "$LIMACTL" delete --force "$DVM_LIMA_NAME"
        printf 'removed %s\n' "$DVM_NAME"
    else
        printf 'no Lima instance: %s\n' "$DVM_NAME"
    fi
    if [ "$remove_config" = "1" ]; then
        rm -f "$config_file"
        rm -f "$DVM_CONFIG_DIR/vms/$DVM_NAME.setup.sh"
        printf 'removed config %s\n' "$config_file"
    elif [ -f "$config_file" ]; then
        printf 'warning: config remains at %s (use --config to remove it)\n' "$config_file" >&2
    fi
}

cmd_new() {
    [ "$#" -eq 1 ] || die "usage: dvm new <vm>"
    valid_name "$1" || die "invalid VM name: $1"
    mkdir -p "$DVM_CONFIG_DIR/vms"
    local f="$DVM_CONFIG_DIR/vms/$1.sh" setup="$DVM_CONFIG_DIR/vms/$1.setup.sh"
    [ ! -e "$f" ] || die "config already exists: $f"
    [ ! -e "$setup" ] || die "setup script already exists: $setup"
    (
        umask 077
        cat > "$f" <<EOF
# shellcheck shell=bash
# Per-VM config. Global config loads first.

DVM_CPUS=4
DVM_MEMORY=8
DVM_DISK=60

# Localhost port forwards.
# DVM_PORTS=(3000:3000 5173:5173)

# Trusted host-owned setup script run by "dvm sync $1".
DVM_SETUP="\$DVM_CONFIG_DIR/vms/$1.setup.sh"
EOF
        cat > "$setup" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail

# Example:
# sudo dnf5 install -y git ripgrep fd-find tmux
#
# Run user commands explicitly as DVM_USER:
# sudo -u "$DVM_USER" -H bash -lc 'mkdir -p "$HOME/.local/bin"'
EOF
    )
    printf 'wrote %s\n' "$f"
    printf 'wrote %s\n' "$setup"
}

usage() {
    cat <<'EOF'
dvm <command> [args]
  sync <vm> | --all       create/start VM and run setup scripts
  sh <vm>                 interactive shell as DVM_USER
  ssh <vm> -- cmd...      non-interactive command as DVM_USER
  cp src dst              copy; one side may be vm:path
  ls [--only-config] [<vm>] list running Lima instances
  stop <vm> | --all [--only-config] stop running VMs
  rm <vm> --yes [--config] stop and delete the Lima instance
  new <vm>                write starter VM config and setup script
  version                 print DVM version
EOF
}

cmd="${1:-ls}"; [ "$#" -gt 0 ] && shift
case "$cmd" in
    sync) cmd_sync "$@" ;;
    sh) cmd_sh "$@" ;;
    ssh) cmd_ssh "$@" ;;
    cp) cmd_cp "$@" ;;
    ls) cmd_ls "$@" ;;
    stop) cmd_stop "$@" ;;
    rm) cmd_rm "$@" ;;
    new) cmd_new "$@" ;;
    version) [ "$#" -eq 0 ] || die "usage: dvm version"; printf 'dvm %s\n' "$DVM_VERSION" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $cmd" ;;
esac
