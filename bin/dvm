#!/usr/bin/env bash
# dvm: tiny Lima + Ansible conductor. One VM per project; Ansible owns guest config.
set -euo pipefail

# --- discovery -------------------------------------------------------------
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    target="$(readlink "$src")"
    case "$target" in
        /*) src="$target" ;;
        *)  src="$(cd "$(dirname "$src")" && pwd)/$target" ;;
    esac
done
DVM_ROOT="$(cd "$(dirname "$src")/.." && pwd)"
DVM_SHARE="${DVM_SHARE_DIR:-$DVM_ROOT/share/dvm}"
DVM_CONFIG_DIR="${DVM_CONFIG_DIR:-$HOME/.config/dvm}"
DVM_CACHE_DIR="${DVM_CACHE_DIR:-$HOME/.cache/dvm}"
LIMACTL="${DVM_LIMACTL:-limactl}"
ANSIBLE_PLAYBOOK="${DVM_ANSIBLE_PLAYBOOK_BIN:-ansible-playbook}"

die() { printf 'dvm: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
lima_name() { printf 'dvm-%s\n' "$1"; }
valid_name() { case "$1" in *[!a-z0-9-]*|''|[!a-z]*) return 1 ;; esac; }

# --- config loading --------------------------------------------------------
load_global() {
    DVM_TEMPLATE="template:fedora"
    DVM_CPUS=2
    DVM_MEMORY=4
    DVM_DISK=30
    DVM_HOST_IP=127.0.0.1
    DVM_USER=developer
    DVM_ANSIBLE_REPO=""
    DVM_ANSIBLE_PLAYBOOK="site.yml"
    DVM_ANSIBLE_EXTRA_ARGS=()
    DVM_USE_BASE=0
    DVM_BASE_NAME="base"
    DVM_BASE_TAGS=(base)
    [ -f "$DVM_CONFIG_DIR/config.sh" ] && . "$DVM_CONFIG_DIR/config.sh"
}

load_vm() {
    valid_name "$1" || die "invalid VM name: $1"
    local f="$DVM_CONFIG_DIR/vms/$1.sh"
    [ -f "$f" ] || die "no config for VM \"$1\" at $f"
    load_global
    DVM_NAME="$1"
    DVM_PORTS=()
    DVM_ANSIBLE_TAGS=()
    DVM_ANSIBLE_EXTRA_VARS=()
    . "$f"
    DVM_LIMA_NAME="$(lima_name "$DVM_NAME")"
    DVM_CODE_DIR="/home/$DVM_USER/code/$DVM_NAME"
    validate_ports
}

# Reject ports config that Lima would reject later, but with a clearer error.
validate_ports() {
    local p host guest extra
    for p in "${DVM_PORTS[@]:-}"; do
        [ -n "$p" ] || continue
        IFS=: read -r host guest extra <<<"$p"
        [ -z "$extra" ] || die "bad port spec (extra ':'): $p"
        [ -n "$host" ] && [ -n "$guest" ] || die "bad port spec: $p"
        case "$host$guest" in *[!0-9]*) die "port must be numeric: $p" ;; esac
        [ "$host" -ge 1 ] && [ "$host" -le 65535 ] || die "port out of range 1-65535: $p"
        [ "$guest" -ge 1 ] && [ "$guest" -le 65535 ] || die "port out of range 1-65535: $p"
    done
}

# --- lock ------------------------------------------------------------------
# mkdir is atomic across POSIX filesystems; trap removes the dir on exit.
lock_vm() {
    mkdir -p "$DVM_CACHE_DIR"
    local d="$DVM_CACHE_DIR/$1.lock"
    if ! mkdir "$d" 2>/dev/null; then
        die "VM \"$1\" busy: another dvm operation is in progress (rm $d if stale)"
    fi
    trap 'rmdir "'"$d"'" 2>/dev/null || true' EXIT INT TERM
}

# --- vars file -------------------------------------------------------------
# Non-secret only. Secrets must be handled inside the Ansible repo via Vault
# or env lookups, never passed through here.
write_vars_file() {
    mkdir -p "$DVM_CACHE_DIR"
    local out="$DVM_CACHE_DIR/$DVM_NAME.vars.yml" p host guest
    {
        printf 'dvm_name: %s\n' "$DVM_NAME"
        printf 'dvm_lima_name: %s\n' "$DVM_LIMA_NAME"
        printf 'dvm_user: %s\n' "$DVM_USER"
        printf 'dvm_code_dir: %s\n' "$DVM_CODE_DIR"
        printf 'dvm_host_ip: %s\n' "$DVM_HOST_IP"
        if [ "${#DVM_PORTS[@]}" -eq 0 ]; then
            printf 'dvm_ports: []\n'
        else
            printf 'dvm_ports:\n'
            for p in "${DVM_PORTS[@]}"; do
                IFS=: read -r host guest <<<"$p"
                printf '  - host: %s\n    guest: %s\n' "$host" "$guest"
            done
        fi
    } > "$out"
    printf '%s\n' "$out"
}

# --- lima command builders -------------------------------------------------
# Populate the global DVM_ARGV array with the Lima command to run.
DVM_ARGV=()

port_forward_args() {
    local p host guest
    for p in "${DVM_PORTS[@]:-}"; do
        [ -n "$p" ] || continue
        IFS=: read -r host guest <<<"$p"
        DVM_ARGV+=(--port-forward "$DVM_HOST_IP:$host:$guest")
    done
}

build_lima_start() {
    DVM_ARGV=("$LIMACTL" start --name "$DVM_LIMA_NAME"
        --cpus "$DVM_CPUS" --memory "$DVM_MEMORY" --disk "$DVM_DISK")
    port_forward_args
    DVM_ARGV+=("$DVM_TEMPLATE")
}

build_lima_clone() {
    local from="$1"
    DVM_ARGV=("$LIMACTL" clone
        --cpus "$DVM_CPUS" --memory "$DVM_MEMORY" --disk "$DVM_DISK")
    port_forward_args
    DVM_ARGV+=("$from" "$DVM_LIMA_NAME")
}

print_argv() {
    local x
    for x in "${DVM_ARGV[@]}"; do printf '  %q\n' "$x"; done
}

# --- ansible invocation ----------------------------------------------------
ansible_invoke() {
    local inventory="$1" vars="$2"
    shift 2
    [ -n "$DVM_ANSIBLE_REPO" ] || die "DVM_ANSIBLE_REPO is not set"
    local playbook="$DVM_ANSIBLE_REPO/$DVM_ANSIBLE_PLAYBOOK"
    [ -f "$playbook" ] || die "playbook not found: $playbook"
    local -a cmd=("$ANSIBLE_PLAYBOOK" -i "$inventory" "$playbook" -e "@$vars")
    if [ "${#DVM_ANSIBLE_TAGS[@]}" -gt 0 ]; then
        local tags
        tags="$(IFS=,; printf '%s' "${DVM_ANSIBLE_TAGS[*]}")"
        cmd+=(--tags "$tags")
    fi
    local v
    for v in "${DVM_ANSIBLE_EXTRA_VARS[@]:-}"; do
        [ -n "$v" ] || continue
        case "$v" in *[Tt][Oo][Kk][Ee][Nn]*|*[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]*|*[Ss][Ee][Cc][Rr][Ee][Tt]*|*[Kk][Ee][Yy]=*)
            die "DVM_ANSIBLE_EXTRA_VARS entry looks like a secret: $v" ;;
        esac
        cmd+=(-e "$v")
    done
    cmd+=("$@")
    [ "${#DVM_ANSIBLE_EXTRA_ARGS[@]}" -gt 0 ] && cmd+=("${DVM_ANSIBLE_EXTRA_ARGS[@]}")
    if [ "${DVM_DRY_RUN:-0}" = "1" ]; then
        printf 'ansible-playbook argv:\n'
        printf '  %q' "${cmd[@]}"
        printf '\n'
        return 0
    fi
    "${cmd[@]}"
}

inventory_for() { printf '%s/.lima/%s/ansible-inventory.yaml\n' "$HOME" "$1"; }

# --- commands --------------------------------------------------------------
cmd_sync() {
    if [ "${1:-}" = "--all" ]; then
        local rc=0 f n
        for f in "$DVM_CONFIG_DIR"/vms/*.sh; do
            [ -f "$f" ] || continue
            n="$(basename "$f" .sh)"
            printf -- '--- sync %s ---\n' "$n"
            ( cmd_sync "$n" ) || rc=1
        done
        return $rc
    fi
    [ "$#" -eq 1 ] || die "usage: dvm sync <vm> | --all"
    load_vm "$1"
    local vars; vars="$(write_vars_file)"

    if [ "${DVM_DRY_RUN:-0}" = "1" ]; then
        printf 'VM: %s (lima: %s)\n' "$DVM_NAME" "$DVM_LIMA_NAME"
        if [ "$DVM_USE_BASE" = "1" ]; then
            build_lima_clone "$(lima_name "$DVM_BASE_NAME")"
            printf 'limactl clone argv:\n'
        else
            build_lima_start
            printf 'limactl start argv:\n'
        fi
        print_argv
        printf 'vars file: %s\n' "$vars"
        printf -- '--- vars ---\n'; cat "$vars"; printf -- '--- /vars ---\n'
        ansible_invoke "$(inventory_for "$DVM_LIMA_NAME")" "$vars"
        return 0
    fi

    lock_vm "$DVM_NAME"
    if ! lima_has "$DVM_LIMA_NAME"; then
        if [ "$DVM_USE_BASE" = "1" ]; then
            local base; base="$(lima_name "$DVM_BASE_NAME")"
            lima_has "$base" || die "DVM_USE_BASE=1 but base \"$base\" is missing (run: dvm base build)"
            build_lima_clone "$base"
        else
            build_lima_start
        fi
        "${DVM_ARGV[@]}"
    fi
    "$LIMACTL" start "$DVM_LIMA_NAME" >/dev/null 2>&1 || "$LIMACTL" start "$DVM_LIMA_NAME"

    local inv; inv="$(inventory_for "$DVM_LIMA_NAME")"
    [ -f "$inv" ] || die "Lima inventory missing: $inv"
    ansible_invoke "$inv" "$vars"
}

lima_has() { "$LIMACTL" list -q 2>/dev/null | grep -Fxq "$1"; }

cmd_sh() {
    [ "$#" -eq 1 ] || die "usage: dvm sh <vm>"
    load_vm "$1"
    exec "$LIMACTL" shell "$DVM_LIMA_NAME"
}

cmd_ssh() {
    [ "$#" -ge 1 ] || die "usage: dvm ssh <vm> -- cmd..."
    local name="$1"; shift
    load_vm "$name"
    [ "${1:-}" = "--" ] && shift
    exec "$LIMACTL" shell "$DVM_LIMA_NAME" -- "$@"
}

cmd_cp() {
    [ "$#" -eq 2 ] || die "usage: dvm cp <src> <dst>"
    local src_arg="$1" dst_arg="$2" src="$1" dst="$2"
    local src_is_vm=0 dst_is_vm=0 vm rest
    if [[ "$src_arg" =~ ^([a-z][a-z0-9-]*):(.*)$ ]]; then
        vm="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"
        src="$(lima_name "$vm"):$rest"; src_is_vm=1
    fi
    if [[ "$dst_arg" =~ ^([a-z][a-z0-9-]*):(.*)$ ]]; then
        vm="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"
        dst="$(lima_name "$vm"):$rest"; dst_is_vm=1
    fi
    [ $((src_is_vm + dst_is_vm)) -ge 1 ] || die "at least one path must be <vm>:<path>"
    [ $((src_is_vm + dst_is_vm)) -le 1 ] || die "cross-VM copy is not supported"
    exec "$LIMACTL" copy "$src" "$dst"
}

cmd_log() {
    [ "$#" -ge 1 ] || die "usage: dvm log <vm> [-f] [args]"
    local name="$1"; shift
    load_vm "$name"
    exec "$LIMACTL" shell "$DVM_LIMA_NAME" sudo journalctl "$@"
}

cmd_ls() {
    local filter="${1:-}"
    local fmt='{{.Name}}	{{.Status}}	{{.CPUs}}	{{.Memory}}'
    local name status cpus mem short
    printf '%-20s %-10s %-5s %-10s\n' VM STATE CPU MEMORY
    while IFS=$'\t' read -r name status cpus mem; do
        case "$name" in dvm-*) short="${name#dvm-}" ;; *) continue ;; esac
        if [ -n "$filter" ] && [ "$short" != "$filter" ]; then continue; fi
        printf '%-20s %-10s %-5s %-10s\n' "$short" "$status" "$cpus" "$mem"
    done < <("$LIMACTL" list --format "$fmt" 2>/dev/null)
}

cmd_stop() {
    if [ "${1:-}" = "--all" ]; then
        local rc=0 n
        while IFS= read -r n; do
            case "$n" in
                dvm-*) "$LIMACTL" stop "$n" || { rc=1; printf 'dvm: stop %s failed\n' "$n" >&2; } ;;
            esac
        done < <("$LIMACTL" list -q)
        return $rc
    fi
    [ "$#" -eq 1 ] || die "usage: dvm stop <vm> | --all"
    "$LIMACTL" stop "$(lima_name "$1")"
}

cmd_rm() {
    [ "$#" -ge 1 ] || die "usage: dvm rm <vm> --yes"
    local name="$1"; shift
    local yes=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yes) yes=1 ;;
            *) die "unknown flag: $1" ;;
        esac
        shift
    done
    [ "$yes" = "1" ] || die "dvm rm requires --yes"
    load_vm "$name"
    lock_vm "$DVM_NAME"
    if lima_has "$DVM_LIMA_NAME"; then
        "$LIMACTL" stop --force "$DVM_LIMA_NAME" >/dev/null 2>&1 || true
        "$LIMACTL" delete --force "$DVM_LIMA_NAME"
    fi
    rm -f "$DVM_CACHE_DIR/$DVM_NAME.vars.yml"
    printf 'removed %s\n' "$DVM_NAME"
}

cmd_new() {
    [ "$#" -eq 1 ] || die "usage: dvm new <vm>"
    valid_name "$1" || die "invalid VM name: $1"
    mkdir -p "$DVM_CONFIG_DIR/vms"
    local f="$DVM_CONFIG_DIR/vms/$1.sh"
    [ ! -e "$f" ] || die "config already exists: $f"
    cat > "$f" <<EOF
# shellcheck shell=bash
# Per-VM config for "$1". Sourced after the global ~/.config/dvm/config.sh.

DVM_CPUS=4
DVM_MEMORY=8
DVM_DISK=60

# Host-to-guest port forwards. Bind IP comes from global DVM_HOST_IP.
# DVM_PORTS=(3000:3000 5173:5173)

# Ansible tags selecting which roles to apply for this VM.
DVM_ANSIBLE_TAGS=(base agent-user sandbox chezmoi)

# Non-secret variables passed to ansible-playbook via -e. Never put tokens
# or keys here — use Ansible Vault or env lookups inside the playbook.
# DVM_ANSIBLE_EXTRA_VARS=(
#   "dvm_profile=$1"
#   "chezmoi_repo=git@github.com:me/dotfiles.git"
# )
EOF
    "${EDITOR:-${VISUAL:-vi}}" "$f"
}

cmd_edit() {
    [ "$#" -eq 1 ] || die "usage: dvm edit <vm>"
    local f="$DVM_CONFIG_DIR/vms/$1.sh"
    [ -f "$f" ] || die "no config for VM \"$1\""
    exec "${EDITOR:-${VISUAL:-vi}}" "$f"
}

cmd_config() {
    case "${1:-}" in
        edit)
            mkdir -p "$DVM_CONFIG_DIR"
            local f="$DVM_CONFIG_DIR/config.sh"
            [ -e "$f" ] || cp "$DVM_SHARE/config.sh.example" "$f" 2>/dev/null || : > "$f"
            exec "${EDITOR:-${VISUAL:-vi}}" "$f"
            ;;
        show)
            cat "$DVM_CONFIG_DIR/config.sh" 2>/dev/null || die "no config at $DVM_CONFIG_DIR/config.sh"
            ;;
        *) die "usage: dvm config edit | show" ;;
    esac
}

cmd_base() {
    load_global
    local base; base="$(lima_name "$DVM_BASE_NAME")"
    case "${1:-}" in
        build)
            local vars="$DVM_CACHE_DIR/$DVM_BASE_NAME.vars.yml"
            mkdir -p "$DVM_CACHE_DIR"
            {
                printf 'dvm_name: %s\n' "$DVM_BASE_NAME"
                printf 'dvm_lima_name: %s\n' "$base"
                printf 'dvm_user: %s\n' "$DVM_USER"
                printf 'dvm_code_dir: /home/%s/code\n' "$DVM_USER"
                printf 'dvm_host_ip: %s\n' "$DVM_HOST_IP"
                printf 'dvm_ports: []\n'
            } > "$vars"
            if ! lima_has "$base"; then
                DVM_PORTS=()
                DVM_LIMA_NAME="$base"
                build_lima_start
                "${DVM_ARGV[@]}"
            fi
            "$LIMACTL" start "$base" >/dev/null 2>&1 || "$LIMACTL" start "$base"
            local inv; inv="$(inventory_for "$base")"
            [ -f "$inv" ] || die "Lima inventory missing: $inv"
            DVM_NAME="$DVM_BASE_NAME"
            DVM_ANSIBLE_TAGS=("${DVM_BASE_TAGS[@]}")
            DVM_ANSIBLE_EXTRA_VARS=()
            ansible_invoke "$inv" "$vars"
            "$LIMACTL" stop "$base"
            ;;
        rm)
            if lima_has "$base"; then
                "$LIMACTL" stop --force "$base" >/dev/null 2>&1 || true
                "$LIMACTL" delete --force "$base"
            fi
            printf 'removed %s\n' "$base"
            ;;
        *) die "usage: dvm base build | rm" ;;
    esac
}

cmd_ansible() {
    [ "$#" -ge 1 ] || die "usage: dvm ansible <vm> -- ansible-playbook-args..."
    local name="$1"; shift
    load_vm "$name"
    [ "${1:-}" = "--" ] && shift
    lima_has "$DVM_LIMA_NAME" || die "VM \"$DVM_NAME\" does not exist (run: dvm sync $DVM_NAME)"
    "$LIMACTL" start "$DVM_LIMA_NAME" >/dev/null 2>&1 || "$LIMACTL" start "$DVM_LIMA_NAME"
    local vars; vars="$(write_vars_file)"
    local inv; inv="$(inventory_for "$DVM_LIMA_NAME")"
    [ -f "$inv" ] || die "Lima inventory missing: $inv"
    ansible_invoke "$inv" "$vars" "$@"
}

cmd_doctor() {
    load_global
    local rc=0
    check() { printf '%-40s %s\n' "$1" "$2"; }
    if have "$LIMACTL"; then
        check "limactl" "ok ($("$LIMACTL" --version 2>/dev/null | head -1))"
    else
        check "limactl" "MISSING"; rc=1
    fi
    if have "$ANSIBLE_PLAYBOOK"; then
        check "ansible-playbook" "ok ($("$ANSIBLE_PLAYBOOK" --version 2>/dev/null | head -1))"
    else
        check "ansible-playbook" "MISSING"; rc=1
    fi
    if [ -n "$DVM_ANSIBLE_REPO" ]; then
        check "DVM_ANSIBLE_REPO" "$DVM_ANSIBLE_REPO"
        if [ -d "$DVM_ANSIBLE_REPO" ]; then
            check "  exists" "ok"
        else
            check "  exists" "MISSING"; rc=1
        fi
        if [ -f "$DVM_ANSIBLE_REPO/$DVM_ANSIBLE_PLAYBOOK" ]; then
            check "  playbook" "ok ($DVM_ANSIBLE_PLAYBOOK)"
        else
            check "  playbook" "MISSING ($DVM_ANSIBLE_PLAYBOOK)"; rc=1
        fi
    else
        check "DVM_ANSIBLE_REPO" "unset"; rc=1
    fi
    if [ -d "$DVM_CONFIG_DIR/vms" ]; then
        check "VM configs" "$(find "$DVM_CONFIG_DIR/vms" -maxdepth 1 -name '*.sh' | wc -l) found"
    else
        check "VM configs" "no $DVM_CONFIG_DIR/vms directory"
    fi
    local n
    while IFS= read -r n; do
        case "$n" in dvm-*) ;; *) continue ;; esac
        if [ -f "$HOME/.lima/$n/ansible-inventory.yaml" ]; then
            check "  $n inventory" "ok"
        else
            check "  $n inventory" "MISSING"; rc=1
        fi
    done < <("$LIMACTL" list -q 2>/dev/null || true)
    return $rc
}

# --- dispatch --------------------------------------------------------------
usage() {
    cat <<'EOF'
dvm <command> [args]
  sync <vm> | --all       create/start VM and run ansible-playbook
  sh <vm>                 interactive limactl shell
  ssh <vm> -- cmd...      non-interactive limactl shell command
  cp src dst              copy; one side may be vm:path
  log <vm> [-f] [args]    guest journalctl
  ls [<vm>]               list running Lima instances (optional name filter)
  stop <vm> | --all       stop running VMs
  rm <vm> --yes           stop and delete the Lima instance
  new <vm>                write stub config and open editor
  edit <vm>               edit per-VM config
  config edit | show      edit/show global config
  base build | rm         build or delete the optional base VM
  ansible <vm> -- args... run ansible-playbook with extra arguments
  doctor                  check Lima, Ansible, repo, playbook, inventory
EOF
}

cmd="${1:-ls}"; [ "$#" -gt 0 ] && shift
case "$cmd" in
    sync) cmd_sync "$@" ;;
    sh) cmd_sh "$@" ;;
    ssh) cmd_ssh "$@" ;;
    cp) cmd_cp "$@" ;;
    log) cmd_log "$@" ;;
    ls) cmd_ls "$@" ;;
    stop) cmd_stop "$@" ;;
    rm) cmd_rm "$@" ;;
    new) cmd_new "$@" ;;
    edit) cmd_edit "$@" ;;
    config) cmd_config "$@" ;;
    base) cmd_base "$@" ;;
    ansible) cmd_ansible "$@" ;;
    doctor) cmd_doctor "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $cmd" ;;
esac
