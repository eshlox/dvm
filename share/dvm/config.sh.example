# shellcheck shell=bash
# Global defaults. Uncomment to override.

# Fedora/dnf5 only.
# DVM_TEMPLATE="template:fedora"

# DVM_CPUS=2
# DVM_MEMORY=4
# DVM_DISK=30

# DVM_USER=developer
# DVM_AGENT_USER=dvm-agent

# DVM_DEFAULT_PACKAGES=(git ripgrep fd-find tmux)
# DVM_DEFAULT_RECIPES=(zsh fzf starship)

# Non-secret recipe settings only.
# DVM_ENV=(MY_TOOL_CHANNEL)

# Hooks are disabled by default.
# DVM_PROJECT_HOOK=0
# DVM_PROJECT_HOOK_PRIVILEGED=0
# DVM_PROJECT_HOOK_GIT_CONFIG=0

# DVM_ALLOW_RECIPE_CONFLICTS=0

# DVM_CODEX_VERSION=0.132.0
# DVM_CLAUDE_CODE_VERSION=2.1.146
# DVM_OPENCODE_VERSION=1.15.6

# DVM_USE_BASE=0
# DVM_BASE_NAME=base
# DVM_BASE_PACKAGES=(git ripgrep fd-find)
# DVM_BASE_RECIPES=(zsh fzf starship)
