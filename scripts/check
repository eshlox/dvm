#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

bash tests/smoke.sh

if command -v shellcheck >/dev/null 2>&1; then
    shellcheck -s bash --severity=warning -e SC1090,SC1091,SC2034,SC2154 \
        bin/dvm install.sh tests/smoke.sh
else
    printf 'check: shellcheck not found; skipping\n' >&2
fi
